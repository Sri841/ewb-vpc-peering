    { "label": "Open tunnel to dashboard", "type": "shell", "command": "bash scripts/tunnel.sh", "problemMatcher": [] },
    { "label": "Run workbook tests", "type": "shell", "command": "bash scripts/tests.sh", "problemMatcher": [] },
